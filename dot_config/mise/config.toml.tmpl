# Global mise config (~/.config/mise/config.toml).
# Pinned runtime versions used by the shell + scripts.
# Project mise.toml / .tool-versions files override these per-repo.

# Use npm for mise's npm backend. The pnpm backend fails with pnpm 12
# (ERR_PNPM_GLOBAL_BIN_DIR_NOT_IN_PATH on mise 2026.9.9). Revert when fixed upstream.
[settings]
auto_update = true
auto_update_check_duration = "7d"

[settings.npm]
package_manager = "npm"

# Reuse GitHub CLI authentication for GitHub-backed mise tools and API requests.
[settings.github]
credential_command = 'gh auth token --hostname github.com'

[tools]
{{ if hasPrefix "Remote-" .chezmoi.hostname -}}
remotectl = "latest"
"npm:@anthropic-ai/claude-code" = { version = "latest", allow_builds = ["@anthropic-ai/claude-code"] }
{{ end -}}
node = "26.11.1"
rust = "stable"
"cargo:https://github.com/rtk-ai/rtk" = "branch:master"
usage = "6.12.1"
pnpm = "12.10.1"
deno = "2.9.7"
"npm:zx" = "8.8.5"
"npm:ntn" = { version = "latest", allow_builds = ["ntn"] }
"npm:playwright" = "latest"
"npm:agent-browser" = "latest"
"conda:ffmpeg" = "latest"
"npm:context-mode" = { version = "1.0.169", allow_builds = ["context-mode", "better-sqlite3"] }
postgres = "18.6"
shellcheck = "0.11.0"
gh = "latest"
glab = "latest"
"npm:@opencode/cli" = { version = "2", allow_builds = ["@opencode/cli"] }
{{ if not (hasPrefix "Remote-" .chezmoi.hostname) -}}
codex = "latest"
pi = "latest"
"npm:vercel" = "latest"
{{ end -}}
chezmoi = "latest"
"aqua:modem-dev/hunk" = "latest"
"github:basecamp/hey-cli" = "latest"
# Pin nightly assets by digest: upstream replaces the nightly downloads in place.
"github:lightpanda-io/browser" = { version = "nightly", asset_pattern = "lightpanda-{{ if eq .chezmoi.arch "arm64" }}aarch64{{ else }}x86_64{{ end }}-{{ if eq .chezmoi.os "darwin" }}macos{{ else }}linux{{ end }}", bin = "lightpanda", checksum = "sha256:{{ if eq .chezmoi.os "darwin" }}{{ if eq .chezmoi.arch "arm64" }}0c07fde6a81338bfaf043397a4531effe55de93fe6e1b781ef1b91a84a30a203{{ else }}9d4394ee358cc3fa2e56b557b9c6ab1e81ba07b5dbcfa3b5bf9a649d15ce9e83{{ end }}{{ else }}{{ if eq .chezmoi.arch "arm64" }}97a61090a8f5bcf9954a45605912298d564b217040549997052cb31397691507{{ else }}e24d135bb5c4c0905cea9ee9a1cd87eff407755af24bd99b659fa64ec907f18d{{ end }}{{ end }}" }
rg = "latest"
ast-grep = "latest"
bat = "latest"
