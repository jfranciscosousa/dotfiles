# Geometry no longer supports GEOMETRY_PROMPT_PREFIX. Set the prompt parts
# before its plugin loads so the user name remains visible.
geometry_username() {
  print -n -- "%F{$GEOMETRY_COLOR_PROMPT}$USER%f"
}
GEOMETRY_PROMPT=(geometry_username geometry_echo geometry_status geometry_path)

# Chezmoi installs Antidote and compiles this plugin list during `chezmoi apply`.
# The compiled bundle avoids manager work on normal shell startup. Fall back to
# Antidote's dynamic loader if a shell opens before its first apply completes.
zsh_plugins="${ZDOTDIR:-$HOME}/.zsh_plugins.txt"
zsh_plugins_bundle="${zsh_plugins%.txt}.zsh"
antidote="${ZDOTDIR:-$HOME}/.antidote/antidote.zsh"

if [[ -r "$antidote" ]]; then
  source "$antidote"
  if [[ -r "$zsh_plugins_bundle" ]]; then
    source "$zsh_plugins_bundle"
  else
    antidote load "$zsh_plugins"
  fi
fi
unset zsh_plugins zsh_plugins_bundle antidote

# Geometry adds a leading space by default. Keep the prefix flush left.
geometry::prompt() {
  export GEOMETRY_STATUS=$status
  PROMPT="$(geometry::wrap $PWD $GEOMETRY_PROMPT) "
}

{{ if and (eq .chezmoi.os "linux") (lookPath "omarchy") -}}
if (( $+functions[_omarchy_zsh_theme_finish] )); then
  _omarchy_zsh_theme_finish
  unfunction _omarchy_zsh_theme_finish
fi
{{ end -}}

# Prezto skips its completion module for dumb terminals. Keep completion
# available there too, but never initialize it a second time.
if (( ! ${+_comps} )); then
  autoload -Uz compinit
  compinit -u
fi

# Register the repository-local completion immediately even when Prezto reuses
# a dump created before this fpath entry existed.
autoload -Uz _mise _octmux
compdef _mise mise
compdef _octmux oc pc tiger-dev dragon-dev

# mise (runtime version manager) - activate manages PATH for interactive shells.
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi

# Keep direnv's standard hook inline to avoid spawning it merely to print this
# function on every startup. The hook itself still runs before every prompt and
# directory change, so environment behavior is unchanged.
if (( $+commands[direnv] )); then
  _direnv_hook() {
    trap -- '' SIGINT
    eval "$(command direnv export zsh)"
    trap - SIGINT
  }
  typeset -ag precmd_functions chpwd_functions
  if (( ! ${precmd_functions[(I)_direnv_hook]} )); then
    precmd_functions=(_direnv_hook $precmd_functions)
  fi
  if (( ! ${chpwd_functions[(I)_direnv_hook]} )); then
    chpwd_functions=(_direnv_hook $chpwd_functions)
  fi
fi
# Custom aliases
source "$HOME/.zsh/aliases.sh"

{{ if eq .chezmoi.os "darwin" }}
source "$HOME/.zsh/macos.sh"
{{ end }}

if [[ -f "$HOME/.zsh/remote.sh" ]]; then
  source "$HOME/.zsh/remote.sh"
fi

if [[ -f "$HOME/.zsh/personal.sh" ]]; then
  source "$HOME/.zsh/personal.sh"
fi

if [[ -f "$HOME/.zsh/custom.sh" ]]; then
  source "$HOME/.zsh/custom.sh"
fi
