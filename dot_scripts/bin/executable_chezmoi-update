#!/usr/bin/env zx

import os from "node:os";
import path from "node:path";

const sourceDir = path.join(os.homedir(), ".local", "share", "chezmoi");

try {
  $.cwd = sourceDir;

  const { stdout } = await $`git status --porcelain`;
  if (stdout.trim()) {
    echo(chalk.yellow("You have pending changes, please review before updating."));
    process.exit(1);
  }

  await $`git pull --ff-only`;
  await $`chezmoi apply --source ${sourceDir}`;
  echo("✅ Chezmoi updated and applied successfully!");
} catch (error) {
  const detail =
    error !== null &&
    typeof error === "object" &&
    "stderr" in error &&
    typeof error.stderr === "string"
      ? error.stderr.trim()
      : "";
  echo(chalk.red(`chezmoi-update failed${detail ? `: ${detail}` : "."}`));
  process.exitCode = 1;
}
