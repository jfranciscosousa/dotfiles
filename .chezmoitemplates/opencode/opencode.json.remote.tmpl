{{/* Remote work machines use GPT models through Remote's AI Gateway. */}}
{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/gpt-6-sol",
  "enabled_providers": ["litellm"],
  "shell": "/bin/zsh",
  "agent": {
    "plan": {
      "model": "litellm/gpt-6-sol",
      "options": {
        "reasoningEffort": "low"
      }
    },
    "build": {
      "model": "litellm/gpt-6-sol",
      "options": {
        "reasoningEffort": "medium"
      }
    },
    "general": {
      "model": "litellm/gpt-6-sol",
      "options": {
        "reasoningEffort": "high"
      }
    },
    "explore": {
      "model": "litellm/gpt-6-luna",
      "options": {
        "reasoningEffort": "high"
      }
    },
    "compaction": {
      "model": "litellm/gpt-6-sol",
      "options": {
        "reasoningEffort": "high"
      }
    },
    "summary": {
      "model": "litellm/gpt-6-sol",
      "options": {
        "reasoningEffort": "high"
      }
    },
    "title": {
      "model": "litellm/gpt-6-luna",
      "options": {
        "reasoningEffort": "high"
      }
    }
  },
  "mcp": {
    "servers": {
      "context-mode": {
        "type": "local",
        "command": ["{{ .chezmoi.homeDir }}/.scripts/bin/context-mode-mcp"],
        "environment": { "CONTEXT_MODE_PLATFORM": "opencode" }
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "snowflake": {
        "type": "remote",
        "url": "https://mcp-gateway.eu-west-1.data.remote.com/snowflake/mcp"
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      },
      "honeycomb": {
        "type": "remote",
        "url": "https://mcp.eu1.honeycomb.io/mcp"
      },
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.com/v1/mcp?toolsets=core,error-tracking&omit_tools=create_datadog_notebook,edit_datadog_notebook,upsert_datadog_dashboard"
      },
      "mixpanel": {
        "type": "remote",
        "url": "https://mcp-eu.mixpanel.com/mcp"
      },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "oauth": {
          "clientId": "1601185624273.8899143856786",
          "callbackPort": 3118,
          "redirectUri": "http://localhost:3118/callback"
        }
      }
    }
  },
  "instructions": ["{{ .chezmoi.homeDir }}/.brains/RTK.md", "{{ .chezmoi.homeDir }}/.config/opencode/context-mode.md"],
  "plugin": [
    {{- if lookPath "cmux" }}
    ".\/plugins\/cmux-session.js",
    {{- end }}
    ".\/plugins\/rtk.ts",
    "opencode-websearch",
    "@dietrichgebert/ponytail"
  ]
}
