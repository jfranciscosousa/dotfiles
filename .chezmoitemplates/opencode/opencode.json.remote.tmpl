{{/* Remote work machines intentionally use GPT/OpenAI, not OpenCode Go. */}}
{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "shell": "/bin/zsh",
  "providers": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          }
        },
        "gpt-5.6-terra": {
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "low",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          }
        }
      }
    }
  },
  "agents": {
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "options": {
        "reasoningEffort": "low"
      }
    },
    "build": {
      "model": "openai/gpt-5.6-sol",
      "options": {
        "reasoningEffort": "medium"
      }
    },
    "general": {
      "model": "openai/gpt-5.6-terra",
      "options": {
        "reasoningEffort": "high"
      }
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "high"
      }
    },
    "compaction": {
      "model": "openai/gpt-5.6-terra",
      "options": {
        "reasoningEffort": "high"
      }
    },
    "summary": {
      "model": "openai/gpt-5.6-terra",
      "options": {
        "reasoningEffort": "high"
      }
    },
    "title": {
      "model": "openai/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "high"
      }
    }
  },
  "mcp": {
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "snowflake": {
        "type": "remote",
        "url": "https://mcp-gateway.eu-west-1.data.remote.com/snowflake/mcp"
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      },
      "honeycomb": {
        "type": "remote",
        "url": "https://mcp.eu1.honeycomb.io/mcp"
      },
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp?omit_tools=create_datadog_notebook,edit_datadog_notebook,upsert_datadog_dashboard"
      },
      "mixpanel": {
        "type": "remote",
        "url": "https://mcp-eu.mixpanel.com/mcp"
      },
      "pganalyze": {
        "type": "remote",
        "url": "https://pganalyze.eu-west-1.remote.com/mcp"
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "oauth": {
          "clientId": "1601185624273.8899143856786",
          "callbackPort": 3118,
          "redirectUri": "http://localhost:3118/callback"
        }
      }
    }
  },
  "instructions": ["{{ .chezmoi.homeDir }}/.brains/RTK.md"],
  "plugins": [
    ".\/plugins\/rtk.ts",
    ".\/plugins\/zed-bell.js",
    ".\/plugins\/critical.ts",
    "opencode-websearch"
  ]
}
