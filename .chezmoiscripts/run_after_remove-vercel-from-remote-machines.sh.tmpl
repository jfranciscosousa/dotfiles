{{- if hasPrefix "Remote-" .chezmoi.hostname -}}
#!/usr/bin/env bash
set -euo pipefail

if command -v mise >/dev/null 2>&1; then
  if mise ls --installed "npm:vercel" 2>/dev/null | grep -q '[^[:space:]]'; then
    mise uninstall --all --yes "npm:vercel"
  fi
  mise reshim
fi

mise_data_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
if [[ "$(uname -s)" == Darwin ]]; then
  mise_cache_dir="${MISE_CACHE_DIR:-$HOME/Library/Caches/mise}"
else
  mise_cache_dir="${MISE_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/mise}"
fi

rm -f "$mise_data_dir/shims/vercel"
rm -rf \
  "$mise_data_dir/installs/npm-vercel" \
  "$mise_cache_dir/npm-vercel"
for npm_meta in "$mise_cache_dir"/npm-meta/*/vercel.json; do
  [[ -e $npm_meta ]] || continue
  rm -f "$npm_meta"
done
{{- end }}
