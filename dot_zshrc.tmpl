typeset -g GEOMETRY_COLOR_EXIT_VALUE='#f7768e'
typeset -g GEOMETRY_COLOR_GIT_DIRTY='#e0af68'
typeset -g GEOMETRY_COLOR_GIT_CLEAN='#9ece6a'
typeset -g GEOMETRY_COLOR_GIT_BARE='#7aa2f7'
typeset -g GEOMETRY_COLOR_GIT_CONFLICTS_UNSOLVED='#f7768e'
typeset -g GEOMETRY_COLOR_GIT_CONFLICTS_SOLVED='#9ece6a'
typeset -g GEOMETRY_COLOR_GIT_BRANCH='#565f89'
typeset -g GEOMETRY_COLOR_GIT_STASHES='#bb9af7'
typeset -g GEOMETRY_COLOR_HG_DIRTY='#e0af68'
typeset -g GEOMETRY_COLOR_HG_CLEAN='#9ece6a'
typeset -g GEOMETRY_COLOR_HG_BRANCH='#565f89'
typeset -g GEOMETRY_COLOR_JOBS='#7dcfff'
typeset -g GEOMETRY_COLOR_TIME_SHORT='#9ece6a'
typeset -g GEOMETRY_COLOR_TIME_NEUTRAL='#a9b1d6'
typeset -g GEOMETRY_COLOR_TIME_LONG='#f7768e'
typeset -g GEOMETRY_COLOR_NO_TIME='#565f89'
typeset -g GEOMETRY_COLOR_DOCKER_MACHINE='#7aa2f7'
typeset -g GEOMETRY_COLOR_KUBE='#7dcfff'
typeset -g GEOMETRY_COLOR_PACKAGER_VERSION='#9ece6a'
typeset -g GEOMETRY_COLOR_RUBY_RVM_VERSION='#f7768e'
typeset -g GEOMETRY_COLOR_RUSTUP_STABLE='#9ece6a'
typeset -g GEOMETRY_COLOR_RUSTUP_BETA='#e0af68'
typeset -g GEOMETRY_COLOR_RUSTUP_NIGHTLY='#f7768e'
