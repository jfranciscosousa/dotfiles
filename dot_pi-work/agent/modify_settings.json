{{- /* chezmoi:modify-template */ -}}
{{- $existing := dict -}}
{{- if .chezmoi.stdin -}}
{{- $existing = .chezmoi.stdin | fromJson -}}
{{- end -}}

{{- /* Pi clones git packages under the agent directory; skills paths resolve from there. */ -}}
{{- $marketplaceSkills := "git/gitlab.com/remote-com/tools/agent-plugin-marketplace/plugins" -}}
{{- $skills := index $existing "skills" | default list -}}
{{- if not (has $marketplaceSkills $skills) -}}
{{- $skills = append $skills $marketplaceSkills -}}
{{- end -}}
{{- $_ := unset $existing "subagents" -}}
{{- $_ := unset $existing "npmCommand" -}}
{{- $managed := dict
  "theme" "dark"
  "defaultProvider" "litellm"
  "defaultModel" "gpt-6.1-sol"
  "defaultThinkingLevel" "medium"
  "hideThinkingBlock" true
  "enabledModels" (list
    "litellm/gpt-6.1-sol"
    "litellm/gpt-6-luna"
    "litellm/gpt-6-astra"
  )
  "packages" (list
    "git:github.com/sting8k/pi-vcc@f16600028524581faf9c3b2e0e99fa7931bbe2d2"
    "npm:@dietrichgebert/ponytail"
    (dict
      "source" "git:git@gitlab.com:remote-com/tools/agent-plugin-marketplace"
      "extensions" (list)
      "skills" (list)
      "prompts" (list)
      "themes" (list)
    )
  )
  "skills" $skills
  "shellPath" "/bin/zsh"
-}}

{{ mergeOverwrite $existing $managed | toPrettyJson }}
