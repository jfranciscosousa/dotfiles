{{- /* chezmoi:modify-template */ -}}
{{- $existing := dict -}}
{{- if .chezmoi.stdin -}}
{{- $existing = .chezmoi.stdin | fromJson -}}
{{- end -}}
{{- if hasKey $existing "hooks" -}}
{{- $_ := unset (index $existing "hooks") "UserPromptSubmit" -}}
{{- $_ := unset (index $existing "hooks") "SubagentStart" -}}
{{- end -}}

{{- $managed := dict
  "env" (dict
    "ENABLE_LSP_TOOL" "1"
    "CLAUDE_CODE_SHELL" "/bin/zsh"
  )
  "permissions" (dict
    "defaultMode" "auto"
  )
  "statusLine" (dict
    "type" "command"
    "command" "bash ~/.claude/statusline-command.sh"
  )
  "effortLevel" "xhigh"
  "modelSettings" (dict
    "claude-sonnet-5-5" (dict "effortLevel" "high")
    "claude-opus-5-5" (dict "effortLevel" "xhigh")
  )
  "tui" "fullscreen"
  "preferredNotifChannel" "terminal_bell"
  "skipAutoPermissionPrompt" true
  "hooks" (dict
    "PreToolUse" (list
      (dict
        "matcher" "Bash"
        "hooks" (list
          (dict
            "type" "command"
            "command" "rtk hook claude"
          )
        )
      )
    )
  )
-}}

{{- if hasPrefix "Remote-" .chezmoi.hostname -}}
{{- $_ := set $managed "model" "claude-sonnet-5-5" -}}
{{- $_ := set $managed "availableModels" (list "claude-sonnet-5-5" "claude-opus-5-5" "claude-fable-5-1") -}}
{{- $_ := set $managed "effortLevel" "medium" -}}
{{- $_ := set $managed "modelSettings" (dict
  "claude-sonnet-5-5" (dict "effortLevel" "medium")
  "claude-opus-5-5" (dict "effortLevel" "medium")
  "claude-fable-5-1" (dict "effortLevel" "medium")
) -}}
{{- $_ := set $managed "extraKnownMarketplaces" (dict
  "remote-claude-plugins" (dict "source" (dict
    "source" "git"
    "url" "git@gitlab.com:remote-com/claude-code-plugin-marketplace.git"
  ))
) -}}
{{- $_ := set $managed "enabledPlugins" (dict "adversarial-review@remote-claude-plugins" true) -}}
{{- end }}

{{ mergeOverwrite $existing $managed | toPrettyJson }}
