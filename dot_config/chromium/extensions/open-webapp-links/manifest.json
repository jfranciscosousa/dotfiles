{
  "manifest_version": 3,
  "name": "Open Webapp Links in Default Browser",
  "version": "1.0.0",
  "key": "",
  "description": "Open external links from Chromium app windows in the system browser.",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
