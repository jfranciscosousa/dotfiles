# Global mise config (~/.config/mise/config.toml).
# Pinned runtime versions used by the shell + scripts.
# Project mise.toml / .tool-versions files override these per-repo.
# Use pnpm for mise's npm backend. pnpm blocks dependency build scripts unless allowed.
[settings.npm]
package_manager = "pnpm"

[tools]
{{ if hasPrefix "Remote-" .chezmoi.hostname -}}
remotectl = "5.9.0"
{{ end -}}
node = "26.7.0"
pnpm = "12.1.0"
deno = "2.9.5"
"npm:zx" = "8.8.5"
"npm:vercel" = "latest"
"npm:@anthropic-ai/claude-code" = { version = "latest", allow_builds = ["@anthropic-ai/claude-code"] }
"npm:@typescript/native-preview" = "7.0.0-dev.20260707.2"
"npm:playwright" = "1.62.1"
postgres = "17.7"
shellcheck = "0.11.0"
gh = "latest"
codex = "latest"
opencode = "latest"
pi = "latest"
"aqua:modem-dev/hunk" = "latest"
"github:basecamp/hey-cli" = "latest"
