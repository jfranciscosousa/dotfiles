#!/usr/bin/env bash
set -euo pipefail

direction=${1:-}
action=${2:-focus}

case "$direction" in
  next | previous) ;;
  *)
    printf 'Usage: %s {next|previous} [focus|move]\n' "${0##*/}" >&2
    exit 2
    ;;
esac

case "$action" in
  focus | move) ;;
  *)
    printf 'Usage: %s {next|previous} [focus|move]\n' "${0##*/}" >&2
    exit 2
    ;;
esac

workspace=$(hyprctl -j activeworkspace)
current=$(jq -r '.id' <<<"$workspace")
monitor=$(jq -r '.monitor' <<<"$workspace")

case "$monitor" in
  DP-1)
    first=1
    last=5
    ;;
  HDMI-A-1)
    first=6
    last=10
    ;;
  *)
    exit 0
    ;;
esac

case "$direction" in
  next)
    ((current < last)) || exit 0
    target=$((current + 1))
    ;;
  previous)
    ((current > first)) || exit 0
    target=$((current - 1))
    ;;
esac

case "$action" in
  focus)
    hyprctl dispatch "hl.dsp.focus({ workspace = \"$target\" })" >/dev/null
    ;;
  move)
    hyprctl dispatch "hl.dsp.window.move({ workspace = \"$target\" })" >/dev/null
    ;;
esac
