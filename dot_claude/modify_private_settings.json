{{- /* chezmoi:modify-template */ -}}
{{- $existing := dict -}}
{{- if .chezmoi.stdin -}}
{{- $existing = .chezmoi.stdin | fromJson -}}
{{- end -}}

{{- $managed := dict
  "env" (dict
    "ENABLE_LSP_TOOL" "1"
  )
  "permissions" (dict
    "defaultMode" "auto"
  )
  "statusLine" (dict
    "type" "command"
    "command" "bash ~/.claude/statusline-command.sh"
  )
  "effortLevel" "xhigh"
  "tui" "fullscreen"
  "preferredNotifChannel" "terminal_bell"
  "skipAutoPermissionPrompt" true
  "hooks" (dict
    "UserPromptSubmit" (list
      (dict
        "hooks" (list
          (dict
            "type" "command"
            "command" "bash ~/.claude/hooks/critical-instructions.sh"
          )
        )
      )
    )
    "SubagentStart" (list
      (dict
        "hooks" (list
          (dict
            "type" "command"
            "command" "bash ~/.claude/hooks/critical-instructions.sh"
          )
        )
      )
    )
    "PreToolUse" (list
      (dict
        "matcher" "Bash"
        "hooks" (list
          (dict
            "type" "command"
            "command" "rtk hook claude"
          )
        )
      )
    )
  )
-}}

{{ mergeOverwrite $existing $managed | toPrettyJson }}
