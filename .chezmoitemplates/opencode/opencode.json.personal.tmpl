{{/* Personal machines use OpenCode with GPT models. */}}
{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "provider": {
    "openai": {
      "whitelist": ["gpt-6.1-sol", "gpt-6-luna", "gpt-6-astra"],
      "models": {
        "gpt-6.1-sol": { "options": { "reasoningEffort": "high", "textVerbosity": "low", "reasoningSummary": "auto" } },
        "gpt-6-luna": { "options": { "reasoningEffort": "low", "textVerbosity": "low", "reasoningSummary": "auto" } },
        "gpt-6-astra": { "options": { "reasoningEffort": "high", "textVerbosity": "low", "reasoningSummary": "auto" } }
      }
    }
  },
  "default_agent": "build",
  "shell": "/bin/zsh",
  "agent": {
    "build": {
      "mode": "primary",
      "description": "Default primary agent for full development work.",
      "model": "openai/gpt-6.1-sol",
      "options": {
        "reasoningEffort": "medium"
      }
    },
    "plan": {
      "mode": "primary",
      "description": "Restricted agent for planning and analysis without making changes.",
      "model": "openai/gpt-6-luna"
    },
    "general": {
      "mode": "subagent",
      "description": "General-purpose agent for researching complex questions and executing multi-step tasks.",
      "model": "openai/gpt-6.1-sol"
    },
    "explore": {
      "model": "openai/gpt-6-luna"
    },
    "title": {
      "model": "openai/gpt-6-luna"
    },
    "summary": {
      "model": "openai/gpt-6-luna"
    },
    "compaction": {
      "model": "openai/gpt-6-luna"
    }
  },
  "mcp": {
    "servers": {
      "context-mode": {
        "type": "local",
        "command": ["{{ .chezmoi.homeDir }}/.scripts/bin/context-mode-mcp"],
        "environment": { "CONTEXT_MODE_PLATFORM": "opencode" }
      }
    }
  },
  "instructions": ["{{ .chezmoi.homeDir }}/.brains/RTK.md", "{{ .chezmoi.homeDir }}/.config/opencode/context-mode.md"],
  "plugin": [
    {{- if lookPath "cmux" }}
    ".\/plugins\/cmux-session.js",
    {{- end }}
    ".\/plugins\/rtk.ts",
    "opencode-websearch",
    "@dietrichgebert/ponytail"
  ]
}
