{{/* Personal machines use OpenCode with GPT models. */}}
{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "provider": {
    "openai": {
      "whitelist": ["gpt-6-sol", "gpt-6-luna", "gpt-6-astra", "gpt-5.6-terra"],
      "models": {
        "gpt-6-sol": { "options": { "reasoningEffort": "high", "textVerbosity": "low", "reasoningSummary": "auto" } },
        "gpt-5.6-terra": { "options": { "reasoningEffort": "high", "textVerbosity": "low", "reasoningSummary": "auto" } },
        "gpt-6-luna": { "options": { "reasoningEffort": "low", "textVerbosity": "low", "reasoningSummary": "auto" } },
        "gpt-6-astra": { "options": { "reasoningEffort": "high", "textVerbosity": "low", "reasoningSummary": "auto" } }
      }
    }
  },
  "default_agent": "build",
  "shell": "/bin/zsh",
  "agent": {
    "build": {
      "mode": "primary",
      "description": "Default primary agent for full development work.",
      "model": "openai/gpt-6-sol",
      "options": {
        "reasoningEffort": "medium"
      }
    },
    "plan": {
      "mode": "primary",
      "description": "Restricted agent for planning and analysis without making changes.",
      "model": "openai/gpt-6-luna"
    },
    "general": {
      "mode": "subagent",
      "description": "General-purpose agent for researching complex questions and executing multi-step tasks.",
      "model": "openai/gpt-6-sol"
    },
    "explore": {
      "model": "openai/gpt-6-luna"
    },
    "title": {
      "model": "openai/gpt-6-luna"
    },
    "summary": {
      "model": "openai/gpt-6-luna"
    },
    "compaction": {
      "model": "openai/gpt-6-luna"
    }
  },
  "instructions": ["{{ .chezmoi.homeDir }}/.brains/RTK.md"],
  "plugin": [
    {{- if lookPath "cmux" }}
    ".\/plugins\/cmux-session.js",
    {{- end }}
    ".\/plugins\/rtk.ts",
    "opencode-websearch",
    "@dietrichgebert/ponytail"
  ]
}
