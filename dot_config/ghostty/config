# Ghostty Configuration
# Place this in ~/.config/ghostty/config

# Keep Ghostty's base palette in sync with the current Omarchy theme.
# Omarchy is Linux-only, so macOS uses this built-in Tokyo Night fallback.
{{ if eq .chezmoi.os "darwin" }}
background = #1a1b26
foreground = #a9b1d6
cursor-color = #c0caf5
selection-background = #292e42
selection-foreground = #c0caf5
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5
{{ end }}
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Tab management
keybind = ctrl+w=close_tab
keybind = ctrl+t=new_tab
keybind = alt+left=previous_tab
keybind = alt+right=next_tab
