{{- if hasPrefix "Remote-" .chezmoi.hostname -}}
#!/usr/bin/env bash
set -euo pipefail

if command -v mise >/dev/null 2>&1; then
  if mise ls --installed codex 2>/dev/null | grep -q '[^[:space:]]'; then
    mise uninstall --all --yes codex
  fi
  mise reshim
fi

mise_data_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
if [[ "$(uname -s)" == Darwin ]]; then
  mise_cache_dir="${MISE_CACHE_DIR:-$HOME/Library/Caches/mise}"
else
  mise_cache_dir="${MISE_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/mise}"
fi

rm -f \
  "$HOME/.local/bin/codex" \
  "$HOME/.local/bin/codex-code-mode-host" \
  "$mise_data_dir/shims/codex" \
  "$mise_cache_dir"/github/*openai-codex*
rm -rf \
  "$HOME/.codex" \
  "$mise_data_dir/downloads/codex" \
  "$mise_data_dir/installs/codex" \
  "$mise_cache_dir/codex"
{{- end }}
