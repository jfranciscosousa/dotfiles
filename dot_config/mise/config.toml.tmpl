# Global mise config (~/.config/mise/config.toml).
# Pinned runtime versions used by the shell + scripts.
# Project mise.toml / .tool-versions files override these per-repo.

# Use npm for mise's npm backend. The pnpm backend fails with pnpm 12
# (ERR_PNPM_GLOBAL_BIN_DIR_NOT_IN_PATH on mise 2026.9.9). Revert when fixed upstream.
[settings]
auto_update = true
auto_update_check_duration = "7d"

[settings.npm]
package_manager = "npm"

# Reuse GitHub CLI authentication for GitHub-backed mise tools and API requests.
[settings.github]
credential_command = 'gh auth token --hostname github.com'

[tools]
{{ if hasPrefix "Remote-" .chezmoi.hostname -}}
remotectl = "latest"
{{ end -}}
"npm:@anthropic-ai/claude-code" = { version = "latest", allow_builds = ["@anthropic-ai/claude-code"] }
node = "26.12.0"
rust = "stable"
"cargo:https://github.com/rtk-ai/rtk" = "branch:master"
usage = { version = "7.1.0", workflow = "publish-cli.yml" }
pnpm = "12.14.0"
deno = "2.9.7"
bun = "1.4.3"
"npm:zx" = "8.8.5"
"npm:ntn" = { version = "latest", allow_builds = ["ntn"] }
"npm:playwright" = "latest"
"npm:agent-browser" = "latest"
"conda:ffmpeg" = "latest"
"npm:context-mode" = { version = "1.0.169", allow_builds = ["context-mode", "better-sqlite3"] }
postgres = "18.6"
shellcheck = "0.11.0"
gh = "latest"
glab = "latest"
"npm:@opencode/cli" = { version = "2", allow_builds = ["@opencode/cli"] }
{{ if not (hasPrefix "Remote-" .chezmoi.hostname) -}}
codex = "latest"
pi = "latest"
"npm:vercel" = "latest"
{{ end -}}
chezmoi = "latest"
"aqua:modem-dev/hunk" = "latest"
"github:basecamp/hey-cli" = "latest"
# Pin release assets by their published SHA-256 checksums.
"github:lightpanda-io/browser" = { version = "1.0.1", asset_pattern = "lightpanda-{{ if eq .chezmoi.arch "arm64" }}aarch64{{ else }}x86_64{{ end }}-{{ if eq .chezmoi.os "darwin" }}macos{{ else }}linux{{ end }}", bin = "lightpanda", checksum = "sha256:{{ if eq .chezmoi.os "darwin" }}{{ if eq .chezmoi.arch "arm64" }}d4b66ac8484f49d7a49e05b6f9342716c747129527fcbe8ffe36679ffa18dd60{{ else }}1fcca0ae7684f470780de611a56e9a8ea612d5ff21e37dbb48905ebac5b918a7{{ end }}{{ else }}{{ if eq .chezmoi.arch "arm64" }}392ba370c12d9f045c36c1477db8b3e2985942c89532732ef8d1610057db7d5c{{ else }}551747e35c51ba107b5d5277eca4b48e077b2a3b40f09a047bf6670448bc35fd{{ end }}{{ end }}" }
rg = "latest"
ast-grep = "latest"
bat = "latest"
